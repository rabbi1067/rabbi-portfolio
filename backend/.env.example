# Set these on the backend service. Never put credentials in frontend environment variables.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Optional instead of ADMIN_PASSWORD: a BCrypt $2a/$2b hash.
ADMIN_PASSWORD_HASH=
ALLOWED_ORIGINS=https://your-frontend.vercel.app,https://rabbi1067.github.io
FRONTEND_URL=https://your-frontend.vercel.app
DATA_DIR=/var/data
PORT=8080
PYTHON_COMMAND=python3
PORTFOLIO_SOURCE=/app/frontend
